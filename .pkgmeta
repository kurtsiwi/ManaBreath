package-as: ManaBreath

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  # Copias de prueba para clientes vivos antes del lanzamiento de Forever.
  # Fuera del zip: anunciarian compatibilidad con Retail y Classic Era, que
  # todavia no esta verificada.
  - ManaBreath_Mainline.toc
  - ManaBreath_Vanilla.toc
  # El avatar es para la pagina de CurseForge, no para el juego: dentro del
  # zip solo seria peso muerto en la carpeta de addons de cada jugador.
  - logo.png
  - .github
  - .luarc.json
  - tests
  - tools
  - MANABREATH_CONTEXTO.md
